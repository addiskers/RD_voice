# --- public reachability (what carriers see) ---------------------------------------------
# API base the carrier fetches answer XML from and posts ring/hangup callbacks to (https in prod)
PUBLIC_HTTP_URL=https://engine.example.com
# Media WebSocket base the carrier connects to (wss in prod). agent-transport listens on WORKER_PORT.
PUBLIC_WS_URL=wss://media.example.com
STREAM_PATH_PER_CALL=false

API_HOST=0.0.0.0
API_PORT=8080
WORKER_HOST=0.0.0.0
WORKER_PORT=8090
WORKER_HTTP_PORT=8091
INTERNAL_API_URL=http://localhost:8080
WORKER_INTERNAL_URL=http://localhost:8091

# --- auth -----------------------------------------------------------------------------------
ENGINE_API_KEY=change-me-platform-to-engine
INTERNAL_TOKEN=change-me-worker-to-api
WEBHOOK_SECRET=change-me-webhook-hmac
BROWSER_WS_KEYS=demo-browser-key

# --- storage --------------------------------------------------------------------------------
# Postgres in production (compose builds postgresql+asyncpg://gvox:${POSTGRES_PASSWORD}@postgres:5432/gvox); SQLite for one developer
DATABASE_URL=sqlite+aiosqlite:///./data/engine.db
RECORDINGS_DIR=./data/recordings
RECORD_CALLS=true
RECORDING_STORAGE=local                   # local | s3 (then set RECORDING_S3_* below)
RECORDING_S3_BUCKET=
RECORDING_S3_ENDPOINT=                    # e.g. https://storage.googleapis.com or a MinIO URL; empty = AWS
RECORDING_S3_REGION=ap-south-1
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=
RECORDING_RETENTION_DAYS=90
RECORDING_URL_MODE=stream                 # stream | signed (S3 presigned redirect)
SPOOL_DIR=./data/spool                    # worker event spool (survives restarts)
MAX_CONCURRENT_CALLS=20                   # engine slots when no worker has registered yet (legacy single-box)
CALL_MAX_SECONDS=600

# --- workers --------------------------------------------------------------------------------
WORKER_ID=                                # default: hostname
WORKER_MAX_SESSIONS=20                    # concurrent calls one worker process accepts
WORKER_HEARTBEAT_SECONDS=5
WORKER_DEAD_AFTER_SECONDS=20
DRAIN_TIMEOUT_SECONDS=900

# --- carrier limits & callback security -----------------------------------------------------
CARRIER_MAX_CONCURRENT=plivo=50,vobiz=50,enablex=50,fake=1000
CARRIER_CPS=plivo=2,vobiz=2,enablex=2,fake=100
CARRIER_VERIFY_SIGNATURES=true            # Plivo V3 signatures on /carrier/*; Vobiz needs VOBIZ_CALLBACK_IPS
CARRIER_VERIFY_LOG_ONLY=false           # true for the first day on a new carrier account: log signature failures instead of rejecting
VOBIZ_CALLBACK_IPS=                       # comma-separated IPs/CIDRs

# --- failover -------------------------------------------------------------------------------
STT_FALLBACK_PROVIDER=sarvam              # second STT vendor (needs its key); "" = off. Flux is never wrapped.
LLM_FALLBACK_PROVIDER=groq

# --- secrets --------------------------------------------------------------------------------
ENGINE_ENCRYPTION_KEY=                    # Fernet key; encrypts BYOK provider keys and webhook secrets at rest

# --- compose stack --------------------------------------------------------------------------
POSTGRES_PASSWORD=                        # required by docker-compose.yml (postgres service + DATABASE_URL); never commit a value
# docker-compose.prod.yml (Caddy with Let's Encrypt): hostnames must resolve to this machine before `up`
ENGINE_HOST=engine.tringtringai.com       # DEV: engine.dev.tringtringai.com  (= PUBLIC_HTTP_URL without https://)
MEDIA_HOST=media.tringtringai.com         # DEV: media.dev.tringtringai.com   (= PUBLIC_WS_URL without wss://)
ACME_EMAIL=ops@tringtringai.com           # Let's Encrypt account / expiry notices
CARRIER_MEDIA_IPS=0.0.0.0/0 ::/0          # space-separated carrier media IPs/CIDRs; narrow once Plivo's list is known

# --- cost estimates -------------------------------------------------------------------------
PRICING_FILE=                             # copy of engine/pricing.json with your contracted rates (empty = list prices)
USD_INR=                                  # exchange rate for the rupee totals (empty = value in the pricing file)

# --- local testing --------------------------------------------------------------------------
ENABLE_TEST_ENDPOINTS=false               # fake carrier + POST /v1/test/telephony-smoke
WORKER_MEDIA_URL=ws://127.0.0.1:8090      # where scripts/fake_carrier.py opens media streams

# --- carriers -------------------------------------------------------------------------------
DEFAULT_PROVIDER=plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=+91XXXXXXXXXX
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_FROM_NUMBER=
ENABLEX_APP_ID=
ENABLEX_APP_KEY=
ENABLEX_FROM_NUMBER=

# --- model providers (engine defaults; agents may carry their own keys) --------------------
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
SARVAM_API_KEY=

DEFAULT_LANGUAGE=en-IN
DEFAULT_STT_PROVIDER=deepgram
DEFAULT_STT_MODEL=flux-general-multi      # Flux end-of-turn (fastest); nova-3 = classic streaming STT + semantic turn detector
DEEPGRAM_LANGUAGE=multi
DEFAULT_LLM_PROVIDER=google
DEFAULT_LLM_MODEL=gemini-2.5-flash-lite   # ~0.7 s first token from India; gemini-2.5-flash ~1.1 s; groq openai/gpt-oss-20b ~0.55 s
DEFAULT_LLM_THINKING_BUDGET=0
STT_LANGUAGE_HINTS=en,hi
DEFAULT_TTS_PROVIDER=cartesia
DEFAULT_TTS_MODEL=sonic-3
DEFAULT_TTS_VOICE=
DEFAULT_TTS_LANGUAGE=en
# second TTS vendor used automatically when the primary fails mid-call (needs its key); empty = off
TTS_FALLBACK_PROVIDER=sarvam
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=rahul
SARVAM_TTS_LANGUAGE=en-IN
DEFAULT_REALTIME_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
DEFAULT_REALTIME_VOICE=Aoede
LOG_LEVEL=INFO

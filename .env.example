# --- public reachability (what carriers see) ---------------------------------------------
# API base the carrier fetches answer XML from and posts ring/hangup callbacks to (https in prod)
PUBLIC_HTTP_URL=https://engine.example.com
# Media WebSocket base the carrier connects to (wss in prod). agent-transport listens on WORKER_PORT.
PUBLIC_WS_URL=wss://media.example.com
STREAM_PATH_PER_CALL=false

API_HOST=0.0.0.0
API_PORT=8080
WORKER_HOST=0.0.0.0
WORKER_PORT=8090
WORKER_HTTP_PORT=8091
INTERNAL_API_URL=http://localhost:8080
WORKER_INTERNAL_URL=http://localhost:8091

# --- auth -----------------------------------------------------------------------------------
ENGINE_API_KEY=change-me-platform-to-engine
INTERNAL_TOKEN=change-me-worker-to-api
WEBHOOK_SECRET=change-me-webhook-hmac
BROWSER_WS_KEYS=demo-browser-key

# --- storage --------------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/engine.db
RECORDINGS_DIR=./data/recordings
RECORD_CALLS=true
MAX_CONCURRENT_CALLS=20
CALL_MAX_SECONDS=600

# --- carriers -------------------------------------------------------------------------------
DEFAULT_PROVIDER=plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=+91XXXXXXXXXX
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_FROM_NUMBER=
ENABLEX_APP_ID=
ENABLEX_APP_KEY=
ENABLEX_FROM_NUMBER=

# --- model providers (engine defaults; agents may carry their own keys) --------------------
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
SARVAM_API_KEY=

DEFAULT_LANGUAGE=en-IN
DEFAULT_STT_PROVIDER=deepgram
DEFAULT_STT_MODEL=flux-general-multi      # Flux end-of-turn (fastest); nova-3 = classic streaming STT + semantic turn detector
DEEPGRAM_LANGUAGE=multi
DEFAULT_LLM_PROVIDER=google
DEFAULT_LLM_MODEL=gemini-2.5-flash-lite   # ~0.7 s first token from India; gemini-2.5-flash ~1.1 s; groq openai/gpt-oss-20b ~0.55 s
DEFAULT_LLM_THINKING_BUDGET=0
STT_LANGUAGE_HINTS=en,hi
DEFAULT_TTS_PROVIDER=cartesia
DEFAULT_TTS_MODEL=sonic-3
DEFAULT_TTS_VOICE=
DEFAULT_TTS_LANGUAGE=en
# second TTS vendor used automatically when the primary fails mid-call (needs its key); empty = off
TTS_FALLBACK_PROVIDER=cartesia
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=rahul
SARVAM_TTS_LANGUAGE=en-IN
DEFAULT_REALTIME_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
DEFAULT_REALTIME_VOICE=Aoede
LOG_LEVEL=INFO
